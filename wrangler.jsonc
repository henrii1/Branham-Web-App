{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "custom-worker.ts",
  // Family Altar generation, daily 12:00 UTC (custom-worker.ts → /api/altar/cron).
  // Each run only generates missing days, so retries after a failure are automatic.
  "triggers": { "crons": ["0 12 * * *"] },
  "name": "branham-web-app",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "branham-web-app"
    }
  ],
  "routes": [
    {
      "pattern": "branhamsermons.ai/*",
      "zone_name": "branhamsermons.ai"
    },
    {
      "pattern": "www.branhamsermons.ai/*",
      "zone_name": "branhamsermons.ai"
    }
  ]
}
